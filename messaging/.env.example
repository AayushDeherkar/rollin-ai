# Photon 2.0 (beta), from app.beta.photon.codes. Never commit real values.
# Project API key with project:read and project:write. Starts with pho_sk_
PHOTON_API_KEY=
# Project id. Starts with pho_prj_
PHOTON_PROJECT_ID=
# Optional: only answer these senders (comma-separated E.164 numbers or iMessage emails)
PHOTON_ALLOWED_SENDERS=

# The web app the bridge talks to, and the address put in links sent to phones
ROLLIN_WEB_URL=http://localhost:3000
ROLLIN_PUBLIC_WEB_URL=

# The leasing office: a separate role, never a client (do not also list it in PHOTON_ALLOWED_SENDERS).
# Approved messages go into its existing conversation (it must have texted the line once). Its replies
# are logged as answers and the findings are texted back to the client. Unset = messages stay in the outbox.
LEASING_OFFICE_NUMBER=
